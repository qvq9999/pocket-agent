<?xml version="1.0" encoding="utf-8"?>
<!-- 侧边栏 / 应用内使用的完整标志（含圆角底与渐变）。
     与 launcher 图标同一套几何参数，保证桌面图标和界面内的标识是同一个东西。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <path android:pathData="M112,0 L400,0 A112,112 0 0 1 512,112 L512,400 A112,112 0 0 1 400,512 L112,512 A112,112 0 0 1 0,400 L0,112 A112,112 0 0 1 112,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="512"
                android:endY="512">
                <item android:offset="0" android:color="#FF5B9BF8" />
                <item android:offset="1" android:color="#FF1550C0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 文件卡 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M306,262 L400,262 A44,44 0 0 1 444,306 L444,400 A44,44 0 0 1 400,444 L306,444 A44,44 0 0 1 262,400 L262,306 A44,44 0 0 1 306,262 Z" />

    <path
        android:pathData="M308,326 L398,326 M308,358 L366,358 M308,390 L384,390"
        android:strokeColor="#1550C0"
        android:strokeWidth="15"
        android:strokeLineCap="round" />

    <!-- 四角星 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M196,66 Q208,186 328,198 Q208,210 196,330 Q184,210 64,198 Q184,186 196,66 Z" />
</vector>
