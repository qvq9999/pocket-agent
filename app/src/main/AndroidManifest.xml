<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        长任务期间持有 Wi-Fi 锁。灭屏后 Wi-Fi 会进省电模式、发包间隔拉长，
        SSE 长连接常在这一刻无声断掉；没有这两条权限，WifiLock 创建出来也拿不到。
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- 接局域网模型（Ollama / LM Studio）在 Android 16 起需要该运行时权限 -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- 多步任务执行期间的前台服务：切后台/锁屏不被回收 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+：没有这个权限通知会被隐藏，但服务仍算前台（保活不受影响） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 后台跑长任务时灭屏会让 CPU 进 Doze，收流/工具执行会停在半路 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
        应用内更新：下载完成后交给系统安装器覆盖安装。
        Android 8.0 起没有它就只能弹「已下载，请手动安装」，无法直接拉起安装流程。
        注意这是 Google Play 的敏感权限（只批文件管理器/应用商店类），
        本应用走自建 Release 分发，不经过商店，因此不受限。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
        长任务保活：把应用加进「电池优化」白名单。
        没有它，国产 ROM 会在灭屏/切后台时把进程冻结，前台服务也拦不住 ——
        用户看到的是"任务跑到一半停了"。跳转是标准 API，但需要先声明这个权限。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Android 11+ 的包可见性：不声明 <queries> 时，queryIntentActivities 只看得见本应用自己。
        结果就是"手机明明装了 WPS/Office"，点产出文件却报「没有能打开 docx 的应用」。
        这里放开 VIEW + 任意 mime 的可见性（intent 里的 */* 会匹配所有声明了 mimeType 的
        intent-filter），另外把常用文档类型单独列一遍 —— 个别 ROM 只按精确类型匹配。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/msword" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.ms-excel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 相机拍照落盘用：把 cacheDir 下的临时 jpg 暴露成一个可写的 content:// -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- dataSync：执行期内保活。不声明 type 的话 Android 14+ 会直接抛异常 -->
        <service
            android:name=".service.AgentRunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
